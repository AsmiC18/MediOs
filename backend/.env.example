PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://medios:change_me@localhost:5432/medios_whatsapp
# Use the existing MediOS issuer/key and documented JWT claims. No public login exists here.
JWT_SECRET=
JWT_ISSUER=medios
JWT_AUDIENCE=medios-api
# Set a currently supported Graph API version from your Meta app dashboard.
META_GRAPH_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=
# This adapter supports one configured business number; the mapping is explicit.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_HOSPITAL_ID=
WHATSAPP_BRANCH_ID=
WORKER_ENABLED=false
# Local-only helpers. Never enable in production.
ALLOW_DEV_TOKEN=false
POSTGRES_PASSWORD=
