NODE_ENV=development

PORT=3000

DATABASE_URL="postgresql://medios:medios@localhost:5433/medios?schema=public"



# =============================================================================

# Core production (required when NODE_ENV=production — see validate-production-config)

# =============================================================================

# JWT signing secret (min 32 characters; never use placeholder values in production)

JWT_SECRET=change-me-use-a-long-random-secret-in-production

# Access JWT lifetime (default 15m)
JWT_ACCESS_TTL=15m

# Refresh session lifetime (default 7d)
REFRESH_TOKEN_TTL=7d

# Comma-separated browser origins (required in production)

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ABDM HIP callback header secret (required in production)

ABDM_CALLBACK_SECRET=



# =============================================================================

# Docker Compose (postgres service + substitution for DATABASE_URL in containers)

# =============================================================================

# Set in project-root .env (not committed). Used by docker-compose.yml for Postgres.

# Must match the password in DATABASE_URL when connecting from the host on port 5433.

POSTGRES_PASSWORD=

POSTGRES_USER=medios

POSTGRES_DB=medios

POSTGRES_HOST_PORT=5433

API_HOST_PORT=3000

# Copy .env.docker.example to .env.docker for API/worker env_file (see README Production Operations).



# =============================================================================

# Auth / registration (optional)

# =============================================================================

AUTH_PUBLIC_REGISTRATION_ENABLED=

AUTH_REGISTRATION_BOOTSTRAP_SECRET=

LOGIN_RATE_LIMIT_ENABLED=true

LOGIN_RATE_LIMIT_MAX_ATTEMPTS=20

LOGIN_RATE_LIMIT_WINDOW_MS=900000

REFRESH_RATE_LIMIT_ENABLED=true

REFRESH_RATE_LIMIT_MAX_ATTEMPTS=30

REFRESH_RATE_LIMIT_WINDOW_MS=900000

REGISTRATION_RATE_LIMIT_ENABLED=true

REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=10

REGISTRATION_RATE_LIMIT_WINDOW_MS=900000

WEBHOOK_RATE_LIMIT_ENABLED=true

WEBHOOK_RATE_LIMIT_MAX_ATTEMPTS=120

WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# When true, Express trust proxy is enabled and X-Forwarded-For may be used for client IP (set behind a trusted reverse proxy in production).
TRUST_PROXY=false

# Periodic purge of expired PostgreSQL rate-limit buckets (0 disables).
RATE_LIMIT_PURGE_INTERVAL_MS=300000



# Seed demo admin (development only — do not use default password in production)

SEED_ADMIN_PASSWORD=MediOS@12345



# =============================================================================

# Clinical attachments (C2.0 local storage — development / single-node only)

# Production should use object storage (C2.1+), not container-local filesystem.

# =============================================================================

# Absolute or relative path for encounter attachment blobs (required for upload/download)

CLINICAL_STORAGE_LOCAL_ROOT=./var/clinical-storage

# Maximum upload size in bytes (default 26214400 = 25 MiB if unset)

CLINICAL_STORAGE_MAX_FILE_SIZE_BYTES=26214400



# =============================================================================

# Razorpay (required in production when RAZORPAY_MOCK_MODE is not true)

# =============================================================================

RAZORPAY_KEY_ID=

RAZORPAY_KEY_SECRET=

RAZORPAY_WEBHOOK_SECRET=

RAZORPAY_MOCK_MODE=false



# =============================================================================

# WhatsApp HTTP APIs, Meta webhooks, and legacy send worker code are removed (Phases B–D1).

# Notification dispatch still accepts outbox channel "whatsapp" and marks SKIPPED when allowed.

# Prisma models / retention env (e.g. PRIVACY_RETENTION_WHATSAPP_MESSAGE_DAYS) remain until DB migration.

# =============================================================================



# =============================================================================

# ABDM (production + ABDM_MOCK_MODE=false: ABDM_CALLBACK_SECRET + sandbox or production client credentials; Consent Manager not implemented in real mode)

# =============================================================================

ABDM_ENV=sandbox

ABDM_MOCK_MODE=true

ABDM_GATEWAY_BASE_URL=https://dev.abdm.gov.in

ABDM_X_CM_ID=sbx

ABDM_ABHA_BASE_URL=https://abhasbx.abdm.gov.in/abha/api

ABDM_CALLBACK_BASE_URL=

ABDM_DEFAULT_HIP_ID=

ABDM_HIECM_API_BASE_PATH=/api/hiecm

ABDM_HFR_SEARCH_URL=

ABDM_CONSENT_MANAGER_URL=

ABDM_SANDBOX_BASE_URL=

ABDM_PRODUCTION_BASE_URL=

ABDM_SANDBOX_CLIENT_ID=

ABDM_SANDBOX_CLIENT_SECRET=

ABDM_PRODUCTION_CLIENT_ID=

ABDM_PRODUCTION_CLIENT_SECRET=

ABDM_REQUEST_TIMEOUT_MS=30000

# Callback JWT verification (required in production when ABDM_MOCK_MODE=false):
# RS256 signature on Authorization: Bearer <jwt> using ABDM gateway public key material.
# Set PEM from gateway /certs OR enable automatic fetch via gateway credentials.
ABDM_CALLBACK_JWT_PUBLIC_KEY=
ABDM_CALLBACK_JWT_USE_GATEWAY_CERTS=false
# Optional claim checks when your ABDM environment documents iss/aud:
ABDM_CALLBACK_JWT_ISSUER=
ABDM_CALLBACK_JWT_AUDIENCE=
ABDM_CALLBACK_JWT_ALGORITHMS=RS256



# =============================================================================

# Job scheduler (runs inside the API process)

# =============================================================================

JOB_SCHEDULER_ENABLED=true

JOB_SCHEDULER_INTERVAL_MS=60000

JOB_CONSENT_EXPIRE_SCHEDULER_ENABLED=true

JOB_BILLING_PAYMENT_RECONCILE_SCHEDULER_ENABLED=true

JOB_BILLING_REFUND_RECONCILE_SCHEDULER_ENABLED=true

JOB_APPOINTMENT_REMINDER_24H_SCHEDULER_ENABLED=true

JOB_APPOINTMENT_REMINDER_48H_SCHEDULER_ENABLED=true

JOB_APPOINTMENT_REMINDER_24H_OFFSET_SCHEDULER_ENABLED=true

JOB_APPOINTMENT_REMINDER_1H_SCHEDULER_ENABLED=true

JOB_SCHEDULER_TEST_NOOP_ENABLED=false

JOB_SCHEDULER_TEST_HOSPITAL_ID=

# Privacy retention (J4 — disabled by default; purges aged audit/WhatsApp/notification rows only)

PRIVACY_RETENTION_ENABLED=false

JOB_PRIVACY_RETENTION_SCHEDULER_ENABLED=false

# Patient CRM at-risk evaluation (one hospital job per UTC day)

JOB_PATIENT_AT_RISK_SCHEDULER_ENABLED=true

# Staff attendance monthly payroll summary (one hospital job per UTC month period)

JOB_ATTENDANCE_MONTHLY_SUMMARY_SCHEDULER_ENABLED=true

PRIVACY_RETENTION_AUDIT_LOG_DAYS=365

PRIVACY_RETENTION_WHATSAPP_MESSAGE_DAYS=90

PRIVACY_RETENTION_NOTIFICATION_DAYS=90

PRIVACY_RETENTION_BATCH_SIZE=200



# =============================================================================

# Job worker (separate process: npm run start:worker)

# =============================================================================

JOB_WORKER_BATCH_SIZE=5

JOB_WORKER_POLL_INTERVAL_MS=2000

JOB_WORKER_STALE_LEASE_MS=300000


