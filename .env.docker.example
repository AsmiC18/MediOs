# Copy to .env.docker for Docker Compose (API + worker). Do not commit .env.docker.

# Also set POSTGRES_PASSWORD in the project-root .env file for compose variable substitution

# (see POSTGRES_PASSWORD below — must match the password embedded in DATABASE_URL for host tools).



# --- Core production (required when NODE_ENV=production in containers) ---

JWT_SECRET=replace-with-at-least-32-characters-random-secret

# Required in NODE_ENV=production. Use the same value on API and worker (32-byte key as 64 hex chars, e.g. openssl rand -hex 32).
# FIELD_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:3000

ABDM_CALLBACK_SECRET=replace-with-callback-shared-secret



# --- Integrations: mock flags must be false in production (validate-production-config) ---

RAZORPAY_MOCK_MODE=false

RAZORPAY_KEY_ID=replace-when-using-real-razorpay

RAZORPAY_KEY_SECRET=replace-when-using-real-razorpay

RAZORPAY_WEBHOOK_SECRET=replace-when-using-real-razorpay

# WhatsApp staff HTTP, webhooks, and legacy send code removed (Phases B–D1). Outbox channel "whatsapp" is dispatch-skipped only.



# --- ABDM (optional beyond callback secret; required for real ABDM gateway calls) ---

ABDM_ENV=sandbox

ABDM_MOCK_MODE=false

# ABDM_SANDBOX_CLIENT_ID=

# ABDM_SANDBOX_CLIENT_SECRET=

# ABDM_PRODUCTION_CLIENT_ID=

# ABDM_PRODUCTION_CLIENT_SECRET=



# --- Clinical attachments (C2.0 local volume in docker-compose; not for production object storage) ---

CLINICAL_STORAGE_LOCAL_ROOT=/var/lib/medios/clinical-storage

CLINICAL_STORAGE_MAX_FILE_SIZE_BYTES=26214400



# --- Job scheduler (runs inside API container) ---

JOB_SCHEDULER_ENABLED=true

JOB_SCHEDULER_INTERVAL_MS=60000

JOB_CONSENT_EXPIRE_SCHEDULER_ENABLED=true

JOB_BILLING_PAYMENT_RECONCILE_SCHEDULER_ENABLED=true

JOB_BILLING_REFUND_RECONCILE_SCHEDULER_ENABLED=true

JOB_APPOINTMENT_REMINDER_24H_SCHEDULER_ENABLED=true

JOB_APPOINTMENT_REMINDER_48H_SCHEDULER_ENABLED=true

JOB_APPOINTMENT_REMINDER_24H_OFFSET_SCHEDULER_ENABLED=true

JOB_APPOINTMENT_REMINDER_1H_SCHEDULER_ENABLED=true

# Non-production test task only:

JOB_SCHEDULER_TEST_NOOP_ENABLED=false

# JOB_SCHEDULER_TEST_HOSPITAL_ID=



# --- Job worker (separate worker container) ---

JOB_WORKER_BATCH_SIZE=5

JOB_WORKER_POLL_INTERVAL_MS=2000

JOB_WORKER_STALE_LEASE_MS=300000


