  hospital  Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch    Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient   Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  policy    PatientInsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  provider  InsuranceProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  admission IpdAdmission?          @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  encounter ClinicalEncounter?     @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  claims    InsuranceClaim[]
  surgeryRequests SurgeryRequest[]

  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([policyId])
  @@index([providerId])
  @@index([status])
  @@index([requestDate])
}

model InsuranceClaim {
  id                   String               @id @default(uuid())
  hospitalId           String
  branchId             String?
  patientId            String
  policyId             String
  providerId           String
  invoiceId            String
  preAuthorizationId   String?
  claimNumber          String
  claimedAmount        Decimal              @db.Decimal(12, 2)
  approvedAmount       Decimal?             @db.Decimal(12, 2)
  paidAmount           Decimal              @default(0) @db.Decimal(12, 2)
  patientResponsibility Decimal             @default(0) @db.Decimal(12, 2)
  status               InsuranceClaimStatus @default(DRAFT)
  submittedAt          DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  paidAt               DateTime?
  rejectionReason      String?
  notes                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  hospital         Hospital                  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch           Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient          Patient                   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  policy           PatientInsurancePolicy    @relation(fields: [policyId], references: [id], onDelete: Restrict)
  provider         InsuranceProvider         @relation(fields: [providerId], references: [id], onDelete: Restrict)
  invoice          Invoice                   @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  preAuthorization InsurancePreAuthorization? @relation(fields: [preAuthorizationId], references: [id], onDelete: SetNull)

  @@unique([hospitalId, claimNumber])
  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([policyId])
  @@index([providerId])
  @@index([invoiceId])
  @@index([status])
  @@index([submittedAt])
  @@index([createdAt])
}

model SurgeryRequest {
  id                 String               @id @default(uuid())
  hospitalId         String
  branchId           String?
  patientId          String
  encounterId        String
  admissionId        String?
  preAuthorizationId String?
  requestedByUserId  String
  procedureName      String
  procedureCode      String?
  indication         String?
  priority           SurgeryPriority      @default(ELECTIVE)
  status             SurgeryRequestStatus @default(REQUESTED)
  requestedAt        DateTime             @default(now())
  scheduledAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  notes              String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  hospital         Hospital                   @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch           Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient          Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter        ClinicalEncounter          @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  admission        IpdAdmission?              @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  preAuthorization InsurancePreAuthorization? @relation(fields: [preAuthorizationId], references: [id], onDelete: SetNull)
  requestedBy      User                       @relation("SurgeryRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  preOpAssessment  SurgeryPreOpAssessment?
  schedule         SurgerySchedule?
  procedureRecord  SurgeryProcedureRecord?
  postOpRecord     SurgeryPostOpRecord?

  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([encounterId])
  @@index([admissionId])
  @@index([preAuthorizationId])
  @@index([status])
  @@index([priority])
  @@index([requestedAt])
}

model SurgeryPreOpAssessment {
  id               String                    @id @default(uuid())
  hospitalId       String
  surgeryRequestId String                    @unique
  assessedByUserId String
  assessmentDate   DateTime                  @default(now())
  notes            String?
  fitnessStatus    SurgeryPreOpFitnessStatus @default(PENDING)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  surgeryRequest SurgeryRequest @relation(fields: [surgeryRequestId], references: [id], onDelete: Cascade)
  assessedBy     User           @relation("SurgeryPreOpAssessedBy", fields: [assessedByUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([fitnessStatus])
}

model SurgerySchedule {
  id                String                @id @default(uuid())
  hospitalId        String
  branchId          String?
  surgeryRequestId  String                @unique
  resourceId        String
  appointmentId     String                @unique
  scheduledByUserId String
  status            SurgeryScheduleStatus @default(SCHEDULED)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  hospital        Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  surgeryRequest  SurgeryRequest @relation(fields: [surgeryRequestId], references: [id], onDelete: Cascade)
  resource        Resource       @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  appointment     Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  scheduledBy     User           @relation("SurgeryScheduledBy", fields: [scheduledByUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([branchId])
  @@index([resourceId])
  @@index([status])
}

model SurgeryProcedureRecord {
  id               String    @id @default(uuid())
  hospitalId       String
  surgeryRequestId String    @unique
  startedAt        DateTime?
  completedAt      DateTime?
  surgeonUserId    String
  assistantUserId  String?
  procedureNotes   String?
  findings         String?
  complications    String?
  outcome          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  surgeryRequest SurgeryRequest @relation(fields: [surgeryRequestId], references: [id], onDelete: Cascade)
  surgeon        User           @relation("SurgerySurgeon", fields: [surgeonUserId], references: [id], onDelete: Restrict)
  assistant      User?          @relation("SurgeryAssistant", fields: [assistantUserId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([surgeonUserId])
}

model SurgeryPostOpRecord {
  id                   String   @id @default(uuid())
  hospitalId           String
  surgeryRequestId     String   @unique
  recordedByUserId     String
  recordedAt           DateTime @default(now())
  notes                String?
  followUpInstructions String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  surgeryRequest SurgeryRequest @relation(fields: [surgeryRequestId], references: [id], onDelete: Cascade)
  recordedBy     User           @relation("SurgeryPostOpRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
}
