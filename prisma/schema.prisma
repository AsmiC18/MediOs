  pharmacyProductId   String?
  isActive            Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  hospital        Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  pharmacyProduct PharmacyProduct? @relation(fields: [pharmacyProductId], references: [id], onDelete: SetNull)
  invoiceItems    InvoiceItem[]

  @@unique([hospitalId, code])
  @@index([hospitalId, isActive])
  @@index([branchId])
}

model PaymentCheckoutIntent {
  id              String                      @id @default(uuid())
  hospitalId      String
  branchId        String?
  invoiceId       String
  paymentId       String?
  amount          Decimal                     @db.Decimal(12, 2)
  currency        String                      @default("INR")
  status          PaymentCheckoutIntentStatus @default(CREATED)
  idempotencyKey  String
  providerOrderId String?
  createdByUserId String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  expiresAt       DateTime?
  lastError       String?

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, idempotencyKey])
  @@index([hospitalId, invoiceId])
  @@index([status])
}

model ReportProjection {
  id           String               @id @default(uuid())
  hospitalId   String
  branchId     String?
  reportType   ReportProjectionType
  periodFrom   DateTime
  periodTo     DateTime
  scopeKey     String               @default("")
  payload      Json
  computedAt   DateTime             @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([hospitalId, branchId, reportType, periodFrom, periodTo, scopeKey])
  @@index([hospitalId, reportType, computedAt])
}

model InsurancePreauthAttachment {
  id               String                         @id @default(uuid())
  hospitalId       String
  branchId         String?
  preauthId        String
  attachmentType   InsurancePreauthAttachmentType @default(OTHER)
  storageKey       String
  originalFileName String
  contentType      String
  sizeBytes        BigInt
  checksumSha256   String
  uploadedByUserId String
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime                       @default(now())

  hospital  Hospital                  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch    Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  preauth   InsurancePreAuthorization @relation(fields: [preauthId], references: [id], onDelete: Cascade)
  uploadedBy User                     @relation("PreauthAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  deletedBy  User?                    @relation("PreauthAttachmentDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  @@index([hospitalId, preauthId])
  @@index([preauthId, deletedAt])
}

model IpdDailyChartEntry {
  id              String                 @id @default(uuid())
  hospitalId      String
  branchId        String?
  admissionId     String
  entryType       IpdDailyChartEntryType
  recordedAt      DateTime               @default(now())
  vitalsJson      Json?
  noteText        String?
  recordedByUserId String
  createdAt       DateTime               @default(now())

  hospital  Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch    Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  admission IpdAdmission  @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  recordedBy User         @relation("IpdChartRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId, admissionId, recordedAt])
}

model SurgeryPreOpChecklistItem {
  id              String   @id @default(uuid())
  hospitalId      String
  surgeryRequestId String
  itemKey         String
  label           String
  isRequired      Boolean  @default(true)
  completedAt     DateTime?
  completedByUserId String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  surgeryRequest SurgeryRequest @relation(fields: [surgeryRequestId], references: [id], onDelete: Cascade)

  @@unique([surgeryRequestId, itemKey])
  @@index([hospitalId, surgeryRequestId])
}
