  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hospital    Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  assignments IpdBedAssignment[]

  @@unique([hospitalId, branchId, wardName, roomNumber, bedNumber])
  @@index([hospitalId])
  @@index([branchId])
  @@index([status])
  @@index([bedType])
  @@index([wardName])
}

model IpdAdmission {
  id              String             @id @default(uuid())
  hospitalId      String
  branchId        String
  patientId       String
  admissionNumber String
  admissionDate   DateTime           @default(now())
  dischargeDate   DateTime?
  status          IpdAdmissionStatus @default(ADMITTED)
  reason          String?
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  hospital    Hospital           @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch      Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Restrict)
  assignments        IpdBedAssignment[]
  clinicalEncounters ClinicalEncounter[]
  insurancePreAuthorizations InsurancePreAuthorization[]
  surgeryRequests    SurgeryRequest[]
  dailyChartEntries  IpdDailyChartEntry[]

  @@unique([hospitalId, admissionNumber])
  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([status])
  @@index([admissionDate])
}

model IpdBedAssignment {
  id          String    @id @default(uuid())
  hospitalId  String
  admissionId String
  bedId       String
  assignedAt  DateTime  @default(now())
  releasedAt  DateTime?
  reason      String?

  hospital  Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  admission IpdAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  bed       IpdBed       @relation(fields: [bedId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([admissionId])
  @@index([bedId])
  @@index([assignedAt])
}

model ClinicalEncounter {
  id             String                  @id @default(uuid())
  hospitalId     String
  branchId       String?
  patientId      String
  appointmentId  String?
  ipdAdmissionId String?
  providerUserId String
  encounterType  ClinicalEncounterType
  status         ClinicalEncounterStatus @default(OPEN)
  startedAt      DateTime                @default(now())
  endedAt        DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  hospital     Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch       Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient      Patient             @relation(fields: [patientId], references: [id], onDelete: Restrict)
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  ipdAdmission IpdAdmission?       @relation(fields: [ipdAdmissionId], references: [id], onDelete: SetNull)
  provider     User                @relation("EncounterProvider", fields: [providerUserId], references: [id], onDelete: Restrict)
  soapNote     ClinicalSoapNote?
  soapNoteVersions ClinicalSoapNoteVersion[]
  diagnoses    ClinicalDiagnosis[]
  prescriptions Prescription[]
  diagnosticOrders DiagnosticOrder[]
  emergencyVisit   EmergencyVisit?
  insurancePreAuthorizations InsurancePreAuthorization[]
  surgeryRequests            SurgeryRequest[]
  clinicalAttachments        ClinicalAttachment[]

  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([ipdAdmissionId])
  @@index([providerUserId])
  @@index([status])
  @@index([encounterType])
}

model ClinicalAttachment {
  id               String                      @id @default(uuid())
  hospitalId       String
  branchId         String?
  patientId        String
  encounterId      String
  storageKey       String
  originalFileName String
  contentType      String
  sizeBytes        BigInt
  checksumSha256   String
  category         ClinicalAttachmentCategory?
  description      String?
  uploadedByUserId String
  deletedAt        DateTime?
  deletedByUserId  String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  hospital    Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter   ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  uploadedBy  User              @relation("ClinicalAttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  deletedBy   User?             @relation("ClinicalAttachmentDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  @@unique([hospitalId, storageKey])
  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([encounterId])
  @@index([deletedAt])
}

model ClinicalSoapNote {
  id              String   @id @default(uuid())
  hospitalId      String
  encounterId     String   @unique
  subjective      String?
  objective       String?
  assessment      String?
  plan            String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hospital  Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  createdBy User              @relation("SoapCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
}

/// Append-only SOAP snapshot history; version N is the SOAP content that became current at version N.
model ClinicalSoapNoteVersion {
  id              String   @id @default(uuid())
  hospitalId      String
  encounterId     String
  version         Int
  subjective      String?
  objective       String?
  assessment      String?
  plan            String?
  createdByUserId String
  createdAt       DateTime @default(now())

  hospital  Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  createdBy User              @relation("SoapVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([encounterId, version])
  @@index([encounterId, createdAt])
  @@index([hospitalId])
}

/// Global ICD-10 reference catalogue (not hospital-scoped). Production requires loading an authoritative dataset.
model Icd10Code {
  code        String   @id
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([description])
  @@index([isActive])
}

model ClinicalDiagnosis {
  id              String                @id @default(uuid())
  hospitalId      String
  encounterId     String
  code            String
  description     String
  diagnosisType   ClinicalDiagnosisType @default(SECONDARY)
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  hospital  Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  createdBy User              @relation("DiagnosisCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([encounterId])
  @@index([code])
}

model Prescription {
  id                 String             @id @default(uuid())
  hospitalId         String
  encounterId        String
  patientId          String
  prescribedByUserId String
  status             PrescriptionStatus @default(ACTIVE)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  hospital          Hospital                     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  encounter         ClinicalEncounter            @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patient           Patient                      @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescribedBy      User                         @relation("PrescriptionPrescriber", fields: [prescribedByUserId], references: [id], onDelete: Restrict)
  items             PrescriptionItem[]
  dispensings       PharmacyDispensing[]
  safetyEvaluation  PrescriptionSafetyEvaluation?
  pharmacyWorkItem  PharmacyPrescriptionWorkItem?

  @@index([hospitalId])
  @@index([encounterId])
  @@index([patientId])
  @@index([status])
}

model PharmacyPrescriptionWorkItem {
  id                    String                             @id @default(uuid())
  hospitalId            String
  branchId              String?
  prescriptionId        String                             @unique
  encounterId           String
  patientId             String
  status                PharmacyPrescriptionWorkItemStatus @default(OPEN)
  lastOutboxId          String?
  fulfilledDispensingId String?                            @unique
  processedAt           DateTime?
  createdAt             DateTime                           @default(now())
  updatedAt             DateTime                           @updatedAt

  hospital            Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  prescription        Prescription        @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  fulfilledDispensing PharmacyDispensing? @relation(fields: [fulfilledDispensingId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([branchId])
  @@index([status])
}

model PrescriptionItem {
  id                   String               @id @default(uuid())
  prescriptionId       String
  medicationName       String
  clinicalDrugId       String?
  drugResolutionStatus DrugResolutionStatus @default(FREE_TEXT)
  dosage               String?
  route                String?
  frequency            String?
  duration             String?
  instructions         String?
  quantity             Int?

  prescription     Prescription             @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  clinicalDrug     ClinicalDrug?            @relation(fields: [clinicalDrugId], references: [id], onDelete: SetNull)
  dispensingItems  PharmacyDispensingItem[]

  @@index([prescriptionId])
  @@index([clinicalDrugId])
}

model ClinicalDrug {
  id                String   @id @default(uuid())
  hospitalId        String
  genericName       String
  brandName         String?
  strength          String?
  dosageForm        String?
  route             String?
  externalConceptId String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  hospital          Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  ingredients       ClinicalDrugIngredient[]
  formularyEntries  HospitalFormularyEntry[]
  prescriptionItems PrescriptionItem[]

  @@index([hospitalId])
  @@index([hospitalId, isActive])
  @@index([genericName])
}

model ClinicalDrugIngredient {
  id                String   @id @default(uuid())
  hospitalId        String
  clinicalDrugId    String
  ingredientName    String
  externalConceptId String?
  createdAt         DateTime @default(now())

  hospital     Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  clinicalDrug ClinicalDrug @relation(fields: [clinicalDrugId], references: [id], onDelete: Cascade)

  @@index([hospitalId])
  @@index([clinicalDrugId])
}

model HospitalFormularyEntry {
  id                      String   @id @default(uuid())
  hospitalId              String
  clinicalDrugId          String
  isActive                Boolean  @default(true)
  defaultPharmacyProductId String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  hospital               Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  clinicalDrug           ClinicalDrug     @relation(fields: [clinicalDrugId], references: [id], onDelete: Cascade)
  defaultPharmacyProduct PharmacyProduct? @relation(fields: [defaultPharmacyProductId], references: [id], onDelete: SetNull)

  @@unique([hospitalId, clinicalDrugId])
  @@index([hospitalId])
  @@index([clinicalDrugId])
}

model HospitalClinicalSafetyPolicy {
  id                         String                     @id @default(uuid())
  hospitalId                 String                     @unique
  allergyUnresolvedDrugDefault ClinicalSafetyPolicyAction @default(WARN)
  allergyIngredientMatch     ClinicalSafetyPolicyAction @default(WARN)
  allergyTextFallback        ClinicalSafetyPolicyAction @default(WARN)
  interactionWhenUnavailable InteractionWhenUnavailable @default(ALLOW_WITH_WARNING)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
}

model PrescriptionSafetyEvaluation {
  id                      String                   @id @default(uuid())
  prescriptionId          String                   @unique
  hospitalId              String
  evaluatedAt             DateTime                 @default(now())
  evaluatorVersion        String
  interactionAdapterStatus InteractionAdapterStatus
  patientUpdatedAt        DateTime
  createdAt               DateTime                 @default(now())

  hospital     Hospital                    @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  prescription Prescription                @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  findings     PrescriptionSafetyFinding[]

  @@index([hospitalId])
}

model PrescriptionSafetyFinding {
  id               String                        @id @default(uuid())
  hospitalId       String
  evaluationId     String
  findingKey       String
  findingType      PrescriptionSafetyFindingType
  severity         PrescriptionSafetySeverity
  summary          String
  detailJson       Json?
  source           PrescriptionSafetyFindingSource
  overridden       Boolean                       @default(false)
  overrideReason   String?
  overrideByUserId String?
  overrideAt       DateTime?
  createdAt        DateTime                      @default(now())

  hospital   Hospital                     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  evaluation PrescriptionSafetyEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, findingKey])
  @@index([hospitalId])
  @@index([evaluationId])
}

model DiagnosticOrder {
  id                String                  @id @default(uuid())
  hospitalId        String
  branchId          String?
  patientId         String
  encounterId       String
  orderNumber       String
  status            DiagnosticOrderStatus   @default(ORDERED)
  priority          DiagnosticOrderPriority @default(NORMAL)
  orderedByUserId   String
  orderedAt         DateTime                @default(now())
  sampleCollectedAt DateTime?
  completedAt       DateTime?
  notes             String?
  aggregatorSubmissionStatus DiagnosticAggregatorSubmissionStatus @default(NONE)
  aggregatorExternalReference String?
  aggregatorSubmittedAt DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  hospital  Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch    Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  orderedBy User              @relation("DiagnosticOrderOrderedBy", fields: [orderedByUserId], references: [id], onDelete: Restrict)
  items     DiagnosticOrderItem[]

  @@unique([hospitalId, orderNumber])
  @@index([aggregatorSubmissionStatus])
  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([encounterId])
  @@index([status])
  @@index([priority])
  @@index([orderedAt])
}

model DiagnosticOrderItem {
  id               String                    @id @default(uuid())
  hospitalId       String
  orderId          String
  testCode         String
  testName         String
  specimenType     String
  /** Optional billable unit price (INR); required for automated diagnostic billing lines. */
  billableUnitPrice Decimal? @db.Decimal(12, 2)
  billableHsnSac    String?
  billableGstRate   Decimal? @db.Decimal(5, 2)
  status           DiagnosticOrderItemStatus @default(PENDING)
  resultValue      String?
  resultUnit       String?
  referenceRange   String?
  resultFlag       DiagnosticResultFlag?
  resultNotes      String?
  resultedAt       DateTime?
  verifiedAt       DateTime?
  resultedByUserId String?
  verifiedByUserId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  hospital   Hospital        @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  order      DiagnosticOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  resultedBy User?           @relation("DiagnosticResultEnteredBy", fields: [resultedByUserId], references: [id], onDelete: SetNull)
  verifiedBy User?           @relation("DiagnosticResultVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([orderId])
  @@index([status])
}

model EmergencyVisit {
  id                 String               @id @default(uuid())
  hospitalId         String
  branchId           String?
  patientId          String
  encounterId        String               @unique
  arrivalAt          DateTime             @default(now())
  status             EmergencyVisitStatus @default(ARRIVED)
  priority           EmergencyPriority    @default(NORMAL)
  chiefComplaint     String?
  notes              String?
  disposition        EmergencyDisposition?
  treatmentStartedAt DateTime?
  dispositionAt      DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  hospital      Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter     ClinicalEncounter @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  triageRecords TriageRecord[]

  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([status])
  @@index([priority])
  @@index([arrivalAt])
}

model TriageRecord {
  id               String            @id @default(uuid())
  hospitalId       String
  emergencyVisitId String
  assessedByUserId String
  assessedAt       DateTime          @default(now())
  priority         EmergencyPriority
  temperature      Float?
  heartRate        Int?
  respiratoryRate  Int?
  systolicBp       Int?
  diastolicBp      Int?
  oxygenSaturation Int?
  painScore        Int?
  consciousness    String?
  notes            String?
  escalatedAt      DateTime?
  escalationReason String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  emergencyVisit EmergencyVisit @relation(fields: [emergencyVisitId], references: [id], onDelete: Cascade)
  assessedBy     User           @relation("TriageAssessedBy", fields: [assessedByUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([emergencyVisitId])
  @@index([assessedAt])
}

model PharmacyProduct {
  id           String   @id @default(uuid())
  hospitalId   String
  branchId     String?
  name         String
  genericName  String?
  strength     String?
  dosageForm   String?
  unit         String
  sku          String?
  reorderLevel Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hospital       Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch         Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  batches        PharmacyBatch[]
  stockMovements PharmacyStockMovement[]
  dispensingItemsDispensed  PharmacyDispensingItem[] @relation("DispensedProduct")
  dispensingItemsPrescribed PharmacyDispensingItem[] @relation("PrescribedProduct")
  purchaseOrderItems PharmacyPurchaseOrderItem[]
  hospitalFormularyEntries HospitalFormularyEntry[]
  billingCatalogueItems    BillingCatalogueItem[]

  @@unique([hospitalId, sku])
  @@index([hospitalId])
  @@index([branchId])
  @@index([isActive])
  @@index([name])
}

model PharmacyBatch {
  id           String   @id @default(uuid())
  hospitalId   String
  branchId     String?
  productId    String
  batchNumber  String
  expiryDate   DateTime
  unitCost     Decimal? @db.Decimal(12, 2)
  sellingPrice Decimal? @db.Decimal(12, 2)
  quantity     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  hospital       Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch         Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product        PharmacyProduct         @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockMovements PharmacyStockMovement[]
  dispensingItems PharmacyDispensingItem[]
  purchaseOrderReceiptLines PharmacyPurchaseOrderReceiptLine[]

  @@unique([hospitalId, productId, batchNumber])
  @@index([hospitalId])
  @@index([branchId])
  @@index([productId])
  @@index([expiryDate])
}

model PharmacyStockMovement {
  id              String                    @id @default(uuid())
  hospitalId      String
  branchId        String?
  productId       String
  batchId         String?
  movementType    PharmacyStockMovementType
  quantity        Int
  referenceType   String?
  referenceId     String?
  reason          String?
  createdAt       DateTime                  @default(now())
  createdByUserId String

  hospital  Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  product   PharmacyProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch     PharmacyBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy User             @relation("PharmacyStockMovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([branchId])
  @@index([productId])
  @@index([batchId])
  @@index([movementType])
  @@index([createdAt])
}

model PharmacyDispensing {
  id              String                   @id @default(uuid())
  hospitalId      String
  branchId        String?
  patientId       String
  prescriptionId  String
  createdByUserId String
  status          PharmacyDispensingStatus @default(PENDING)
  dispensedAt     DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  hospital     Hospital                 @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch       Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient      Patient                  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescription Prescription             @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  createdBy    User                     @relation("PharmacyDispensingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items        PharmacyDispensingItem[]
  prescriptionWorkItemFulfillment PharmacyPrescriptionWorkItem?

  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([prescriptionId])
  @@index([status])
  @@index([dispensedAt])
}

model PharmacyDispensingItem {
  id                 String   @id @default(uuid())
  dispensingId       String
  prescriptionItemId String
  productId          String
  prescribedProductId String?
  batchId            String
  quantity           Int
  unitPrice          Decimal  @db.Decimal(12, 2)
  substitutionReason String?
  substitutedByUserId String?
  substitutedAt      DateTime?
  createdAt          DateTime @default(now())

  dispensing       PharmacyDispensing @relation(fields: [dispensingId], references: [id], onDelete: Cascade)
  prescriptionItem PrescriptionItem   @relation(fields: [prescriptionItemId], references: [id], onDelete: Restrict)
  product          PharmacyProduct    @relation("DispensedProduct", fields: [productId], references: [id], onDelete: Restrict)
  prescribedProduct PharmacyProduct?   @relation("PrescribedProduct", fields: [prescribedProductId], references: [id], onDelete: SetNull)
  batch            PharmacyBatch      @relation(fields: [batchId], references: [id], onDelete: Restrict)
  substitutedBy    User?              @relation("PharmacySubstitutionBy", fields: [substitutedByUserId], references: [id], onDelete: SetNull)

  @@index([dispensingId])
  @@index([prescriptionItemId])
  @@index([productId])
  @@index([prescribedProductId])
  @@index([batchId])
}

model PharmacySupplier {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  code        String?
  contactName String?
  phone       String?
  email       String?
  address     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital       Hospital                @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  purchaseOrders PharmacyPurchaseOrder[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
  @@index([isActive])
  @@index([name])
}

model PharmacyPurchaseOrder {
  id               String                      @id @default(uuid())
  hospitalId       String
  branchId         String?
  supplierId       String
  poNumber         String
  status           PharmacyPurchaseOrderStatus @default(DRAFT)
  notes            String?
  createdByUserId  String
  submittedAt      DateTime?
  approvedAt       DateTime?
  approvedByUserId String?
  cancelledAt      DateTime?
  cancelReason     String?
  fullyReceivedAt  DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  hospital  Hospital          @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch    Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier  PharmacySupplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User              @relation("PharmacyPurchaseOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedBy User?            @relation("PharmacyPurchaseOrderApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  items     PharmacyPurchaseOrderItem[]
  receipts  PharmacyPurchaseOrderReceipt[]

  @@unique([hospitalId, poNumber])
  @@index([hospitalId])
  @@index([branchId])
  @@index([supplierId])
  @@index([status])
