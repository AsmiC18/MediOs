  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  provider PaymentProvider @default(RAZORPAY)
  payerType PaymentPayerType @default(PATIENT)
  status   PaymentStatus   @default(INITIATED)

  insuranceClaimId String?
  /** Idempotent insurer settlement / manual payment key (hospital-scoped). */
  idempotencyKey   String?

  providerPaymentLinkId String?
  providerPaymentId     String?
  providerOrderId       String?

  failureReason String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoice         Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  insuranceClaim  InsuranceClaim? @relation(fields: [insuranceClaimId], references: [id], onDelete: SetNull)
  refunds         Refund[]

  @@unique([provider, providerPaymentLinkId])
  @@unique([provider, providerPaymentId])
  @@unique([hospitalId, idempotencyKey])
  @@index([hospitalId])
  @@index([invoiceId])
  @@index([status])
  @@index([payerType])
  @@index([insuranceClaimId])
}

model Refund {
