model Invoice {
  id            String        @id @default(uuid())
  hospitalId    String
  branchId      String?
  patientId     String
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  currency String @default("INR")

  subtotalAmount Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  /** Patient portion after insurance claim approval (Razorpay collectible). */
  insurancePatientResponsibilityAmount Decimal? @db.Decimal(12, 2)
  /** Insurer/TPA portion after claim approval (informational). */
  insurancePayerResponsibilityAmount   Decimal? @db.Decimal(12, 2)

  supplierGstin          String?
  supplierStateCode      String?
  placeOfSupplyStateCode String?
  supplyType             GstSupplyType?

  cgstAmount Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount Decimal @default(0) @db.Decimal(12, 2)
  igstAmount Decimal @default(0) @db.Decimal(12, 2)

  notes    String?
  issuedAt DateTime?
  paidAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
  payments Payment[]
  insuranceClaims InsuranceClaim[]
  paymentCheckoutIntents PaymentCheckoutIntent[]

  @@unique([hospitalId, invoiceNumber])
  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id         String @id @default(uuid())
  invoiceId  String
  hospitalId String

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  hsnSac           String?
  gstRate          Decimal @default(0) @db.Decimal(5, 2)
  taxableAmount    Decimal @db.Decimal(12, 2)
  cgstRate         Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount       Decimal @default(0) @db.Decimal(12, 2)
  sgstRate         Decimal @default(0) @db.Decimal(5, 2)
  sgstAmount       Decimal @default(0) @db.Decimal(12, 2)
  igstRate         Decimal @default(0) @db.Decimal(5, 2)
  igstAmount       Decimal @default(0) @db.Decimal(12, 2)
  lineTotalWithTax Decimal @db.Decimal(12, 2)

  sortOrder Int @default(0)

  /** Idempotent billing source (e.g. staff.attendance.consultation:{appointmentId}). */
  sourceKey String?

  /** Reference to catalogue row at issue time; billable values are snapshotted on this line. */
  billingCatalogueItemId String?
  /** Snapshot of catalogue code at issue time (stable if catalogue code changes). */
  billingCatalogueCode   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice              Invoice               @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  hospital             Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  billingCatalogueItem BillingCatalogueItem? @relation(fields: [billingCatalogueItemId], references: [id], onDelete: SetNull)

  @@unique([hospitalId, sourceKey])
  @@index([invoiceId])
  @@index([hospitalId])
}

model Payment {
  id         String  @id @default(uuid())
  hospitalId String
  branchId   String?
