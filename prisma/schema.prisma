model Job {
  id             String    @id @default(uuid())
  hospitalId     String
  branchId       String?
  type           String
  idempotencyKey String
  payload        Json
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int
  availableAt    DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  startedAt      DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([hospitalId, type, idempotencyKey])
  @@index([status, availableAt])
  @@index([hospitalId, status, availableAt])
  @@index([hospitalId, branchId, status, availableAt])
}

/// Durable domain-event intent for transactional notification dispatch (H1 foundation).
model DomainEventOutbox {
  id             String                   @id @default(uuid())
  hospitalId     String
  branchId       String?
  eventType      String
  entityType     String
  entityId       String
  payload        Json
  status         DomainEventOutboxStatus  @default(PENDING)
  idempotencyKey String
  createdAt      DateTime                 @default(now())
  processedAt    DateTime?

  hospital     Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  notification Notification?

  @@unique([hospitalId, idempotencyKey])
  @@index([status, createdAt])
  @@index([hospitalId])
  @@index([hospitalId, eventType])
  @@index([entityType, entityId])
}

/// Persisted notification intent (H2). PENDING here means not yet delivered by a channel.
model Notification {
  id             String             @id @default(uuid())
  hospitalId     String
  branchId       String?
  patientId      String?
  outboxId       String?            @unique
  category       String
  channel        String
  templateKey    String?
  payload        Json
  status         NotificationStatus @default(PENDING)
  idempotencyKey String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  dispatchedAt   DateTime?
  failedAt       DateTime?
  cancelledAt    DateTime?
  lastError      String?

  hospital Hospital            @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient  Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  outbox          DomainEventOutbox? @relation(fields: [outboxId], references: [id], onDelete: SetNull)
  whatsAppMessage WhatsAppMessage?

  @@unique([hospitalId, idempotencyKey])
  @@index([hospitalId])
  @@index([hospitalId, status, createdAt])
  @@index([outboxId])
  @@index([patientId, createdAt])
}

/// Hospital-scoped patient preference for transactional WhatsApp (H6-A).
