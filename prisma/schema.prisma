generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ResourceType {
  DOCTOR
  ROOM
  EQUIPMENT
  OPERATION_THEATRE
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AttendanceStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
}

enum PatientAtRiskStatus {
  INSUFFICIENT_HISTORY
  NOT_AT_RISK
  AT_RISK
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

enum GstSupplyType {
  INTRA_STATE
  INTER_STATE
}

enum PaymentProvider {
  RAZORPAY
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageType {
  TEXT
  TEMPLATE
}

enum WhatsAppMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsAppConversationState {
  IDLE
  AWAITING_INPUT
  ACTIVE
  CLOSED
}

enum AbdmEnvironment {
  SANDBOX
  PRODUCTION
}

enum AbdmRegistrationStatus {
  NOT_REGISTERED
  PENDING
  REGISTERED
  SUSPENDED
}

enum AbhaLinkStatus {
  UNLINKED
  LINK_PENDING
  LINKED
  VERIFICATION_FAILED
  REVOKED
}

enum AbhaVerificationMethod {
  DEMOGRAPHICS
  MOBILE_OTP
  QR_SCAN
  PROFILE_LOGIN
}

enum AbdmConsentStatus {
  DRAFT
  REQUESTED
  GRANTED
  DENIED
  EXPIRED
  REVOKED
}

enum AbdmConsentAuditAction {
  CREATED
  STATUS_CHANGED
  GRANTED
  DENIED
  EXPIRED
  REVOKED
}

enum OpdQueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum OpdQueuePriority {
  NORMAL
  URGENT
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  INACTIVE
}

enum BedType {
  GENERAL
  PRIVATE
  ICU
  ISOLATION
}

enum IpdAdmissionStatus {
  ADMITTED
  DISCHARGED
  CANCELLED
}

enum ClinicalEncounterType {
  OPD
  IPD
  EMERGENCY
}

enum ClinicalEncounterStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum ClinicalDiagnosisType {
  PRIMARY
  SECONDARY
}

enum DiagnosticOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum DiagnosticOrderPriority {
  NORMAL
  URGENT
}

enum DiagnosticOrderItemStatus {
  PENDING
  RESULTED
  VERIFIED
}

enum DiagnosticResultFlag {
  NORMAL
  LOW
  HIGH
  ABNORMAL
}

enum EmergencyVisitStatus {
  ARRIVED
  TRIAGED
  IN_TREATMENT
  DISCHARGED
  ADMITTED
  TRANSFERRED
  LEFT_WITHOUT_BEING_SEEN
  CANCELLED
}

enum EmergencyPriority {
  EMERGENCY
  URGENT
  NORMAL
}

enum EmergencyDisposition {
  DISCHARGED
  ADMITTED
  TRANSFERRED
  LEFT_WITHOUT_BEING_SEEN
}

enum PrescriptionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PharmacyStockMovementType {
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  DISPENSE
  RETURN
  EXPIRED
}

enum PharmacyDispensingStatus {
  PENDING
  DISPENSED
  CANCELLED
}

enum InsuranceProviderType {
  INSURANCE
  TPA
}

enum InsuranceEmpanelmentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PatientInsurancePolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum InsurancePreAuthorizationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  CANCELLED
}

enum InsuranceClaimStatus {
  DRAFT
  READY
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum SurgeryPriority {
  URGENT
  ELECTIVE
}

enum SurgeryRequestStatus {
  REQUESTED
  PRE_OP
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SurgeryPreOpFitnessStatus {
  PENDING
  FIT
  NOT_FIT
  DEFERRED
}

enum SurgeryScheduleStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Hospital {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  gstin     String?
  stateCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultWorkScheduleId String?                @unique
  defaultWorkSchedule   WorkSchedule?          @relation("HospitalDefaultWorkSchedule", fields: [defaultWorkScheduleId], references: [id], onDelete: SetNull)
  defaultBookingRuleId  String?                @unique
  defaultBookingRule    BookingRule?           @relation("HospitalDefaultBookingRule", fields: [defaultBookingRuleId], references: [id], onDelete: SetNull)
  branches              Branch[]
  users                 User[]
  roles                 Role[]
  patients              Patient[]
  auditLogs             AuditLog[]
  resources             Resource[]
  appointments          Appointment[]
  attendances           Attendance[]
  workSchedules         WorkSchedule[]
  bookingRules          BookingRule[]
  rosterEntries         RosterEntry[]
  patientFieldHistories PatientFieldHistory[]
  invoices              Invoice[]
  invoiceItems          InvoiceItem[]
  payments              Payment[]
  refunds               Refund[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages      WhatsAppMessage[]
  abdmHospitalConfig    AbdmHospitalConfig?
  abdmProfessionalLinks AbdmProfessionalLink[]
  patientAbhaLinks      PatientAbhaLink[]
  abdmConsents          AbdmConsent[]
  abdmConsentAuditLogs  AbdmConsentAuditLog[]
  opdQueueEntries       OpdQueueEntry[]
  ipdBeds               IpdBed[]
  ipdAdmissions         IpdAdmission[]
  ipdBedAssignments     IpdBedAssignment[]
  clinicalEncounters    ClinicalEncounter[]
  clinicalSoapNotes     ClinicalSoapNote[]
  clinicalDiagnoses     ClinicalDiagnosis[]
  prescriptions         Prescription[]
  diagnosticOrders      DiagnosticOrder[]
  diagnosticOrderItems  DiagnosticOrderItem[]
  emergencyVisits       EmergencyVisit[]
  triageRecords         TriageRecord[]
  pharmacyProducts      PharmacyProduct[]
  pharmacyBatches       PharmacyBatch[]
  pharmacyStockMovements PharmacyStockMovement[]
  pharmacyDispensings   PharmacyDispensing[]
  insuranceProviders    InsuranceProvider[]
  insuranceEmpanelments InsuranceEmpanelment[]
  patientInsurancePolicies PatientInsurancePolicy[]
  insurancePreAuthorizations InsurancePreAuthorization[]
  insuranceClaims       InsuranceClaim[]
  surgeryRequests       SurgeryRequest[]
  surgeryPreOpAssessments SurgeryPreOpAssessment[]
  surgerySchedules      SurgerySchedule[]
  surgeryProcedureRecords SurgeryProcedureRecord[]
  surgeryPostOpRecords  SurgeryPostOpRecord[]

  @@index([code])
}

model Branch {
  id         String   @id @default(uuid())
  hospitalId String
  name       String
  code       String
  address    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital              Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  workScheduleId        String?                @unique
  workSchedule          WorkSchedule?          @relation("BranchWorkSchedule", fields: [workScheduleId], references: [id], onDelete: SetNull)
  bookingRuleId         String?                @unique
  bookingRule           BookingRule?           @relation("BranchBookingRule", fields: [bookingRuleId], references: [id], onDelete: SetNull)
  users                 User[]
  patients              Patient[]
  auditLogs             AuditLog[]
  resources             Resource[]
  appointments          Appointment[]
  attendances           Attendance[]
  rosterEntries         RosterEntry[]
  invoices              Invoice[]
  payments              Payment[]
  refunds               Refund[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages      WhatsAppMessage[]
  abdmConsents          AbdmConsent[]
  opdQueueEntries       OpdQueueEntry[]
  ipdBeds               IpdBed[]
  ipdAdmissions         IpdAdmission[]
  clinicalEncounters    ClinicalEncounter[]
  diagnosticOrders      DiagnosticOrder[]
  emergencyVisits       EmergencyVisit[]
  pharmacyProducts      PharmacyProduct[]
  pharmacyBatches       PharmacyBatch[]
  pharmacyDispensings   PharmacyDispensing[]
  insurancePreAuthorizations InsurancePreAuthorization[]
  insuranceClaims       InsuranceClaim[]
  surgeryRequests       SurgeryRequest[]
  surgerySchedules      SurgerySchedule[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model WorkSchedule {
  id            String   @id @default(uuid())
  hospitalId    String
  workStartTime String
  workEndTime   String
  timezone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalDefault Hospital? @relation("HospitalDefaultWorkSchedule")
  branch          Branch?   @relation("BranchWorkSchedule")

  @@index([hospitalId])
}

model BookingRule {
  id                  String   @id @default(uuid())
  hospitalId          String
  minDurationMinutes  Int      @default(5)
  maxDurationMinutes  Int      @default(480)
  slotDurationMinutes Int      @default(15)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalDefault Hospital? @relation("HospitalDefaultBookingRule")
  branch          Branch?   @relation("BranchBookingRule")

  @@index([hospitalId])
}

model User {
  id           String     @id @default(uuid())
  hospitalId   String
  branchId     String?
  roleId       String
  name         String
  email        String?
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hospital              Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch                Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role                  Role                  @relation(fields: [roleId], references: [id])
  auditLogs             AuditLog[]
  attendances           Attendance[]
  rosterEntries         RosterEntry[]
  patientFieldHistories PatientFieldHistory[]
  patientsMerged        Patient[]             @relation("PatientMergedBy")
  abdmProfessionalLink  AbdmProfessionalLink?
  abdmConsentsRequested AbdmConsent[]         @relation("ConsentRequestedBy")
  abdmConsentAuditLogs  AbdmConsentAuditLog[]
  clinicalEncountersProvided ClinicalEncounter[] @relation("EncounterProvider")
  clinicalSoapNotesCreated   ClinicalSoapNote[]  @relation("SoapCreatedBy")
  clinicalDiagnosesCreated   ClinicalDiagnosis[] @relation("DiagnosisCreatedBy")
  prescriptionsPrescribed    Prescription[]      @relation("PrescriptionPrescriber")
  diagnosticOrdersOrdered    DiagnosticOrder[]   @relation("DiagnosticOrderOrderedBy")
  diagnosticResultsEntered   DiagnosticOrderItem[] @relation("DiagnosticResultEnteredBy")
  diagnosticResultsVerified  DiagnosticOrderItem[] @relation("DiagnosticResultVerifiedBy")
  triageRecordsAssessed      TriageRecord[]        @relation("TriageAssessedBy")
  pharmacyStockMovementsCreated PharmacyStockMovement[] @relation("PharmacyStockMovementCreatedBy")
  pharmacyDispensingsCreated    PharmacyDispensing[]    @relation("PharmacyDispensingCreatedBy")
  surgeryRequestsRequested      SurgeryRequest[]        @relation("SurgeryRequestedBy")
  surgeryPreOpAssessments       SurgeryPreOpAssessment[] @relation("SurgeryPreOpAssessedBy")
  surgerySchedulesCreated       SurgerySchedule[]       @relation("SurgeryScheduledBy")
  surgeryProcedureRecordsSurgeon SurgeryProcedureRecord[] @relation("SurgerySurgeon")
  surgeryProcedureRecordsAssistant SurgeryProcedureRecord[] @relation("SurgeryAssistant")
  surgeryPostOpRecords          SurgeryPostOpRecord[]   @relation("SurgeryPostOpRecordedBy")

  @@unique([hospitalId, email])
  @@index([hospitalId])
  @@index([branchId])
  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital    Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Patient {
  id                      String               @id @default(uuid())
  hospitalId              String
  branchId                String?
  phone                   String
  firstName               String
  lastName                String?
  email                   String?
  dateOfBirth             DateTime?
  gender                  Gender?
  abhaId                  String?
  allergies               String[]             @default([])
  chronicConditions       String[]             @default([])
  emergencyContacts       Json?
  mergedIntoPatientId     String?
  mergedAt                DateTime?
  mergedByUserId          String?
  isAtRisk                Boolean              @default(false)
  atRiskStatus            PatientAtRiskStatus?
  suggestedAction         String?
  atRiskEvaluatedAt       DateTime?
  daysSinceLastVisit      Int?
  averageVisitCadenceDays Float?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  hospital              Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  mergedIntoPatient     Patient?               @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id], onDelete: SetNull)
  mergedPatients        Patient[]              @relation("PatientMerge")
  mergedByUser          User?                  @relation("PatientMergedBy", fields: [mergedByUserId], references: [id], onDelete: SetNull)
  appointments          Appointment[]
  fieldHistory          PatientFieldHistory[]
  invoices              Invoice[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages      WhatsAppMessage[]
  abhaLink              PatientAbhaLink?
  abdmConsents          AbdmConsent[]
  opdQueueEntries       OpdQueueEntry[]
  ipdAdmissions         IpdAdmission[]
  clinicalEncounters    ClinicalEncounter[]
  prescriptions         Prescription[]
  diagnosticOrders      DiagnosticOrder[]
  emergencyVisits       EmergencyVisit[]
  pharmacyDispensings   PharmacyDispensing[]
  patientInsurancePolicies PatientInsurancePolicy[]
  insurancePreAuthorizations InsurancePreAuthorization[]
  insuranceClaims       InsuranceClaim[]
  surgeryRequests       SurgeryRequest[]

  @@unique([hospitalId, phone])
  @@index([hospitalId])
  @@index([branchId])
  @@index([phone])
  @@index([abhaId])
  @@index([mergedIntoPatientId])
  @@index([isAtRisk])
}

model PatientFieldHistory {
  id              String   @id @default(uuid())
  hospitalId      String
  patientId       String
  fieldName       String
  oldValue        Json?
  newValue        Json?
  changedByUserId String
  changedAt       DateTime @default(now())

  hospital  Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  changedBy User     @relation(fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([patientId])
  @@index([changedByUserId])
  @@index([changedAt])
}

model Resource {
  id          String         @id @default(uuid())
  hospitalId  String
  branchId    String?
  type        ResourceType
  name        String
  description String?
  status      ResourceStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  hospital             Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  appointmentResources AppointmentResource[]
  surgerySchedules     SurgerySchedule[]

  @@index([hospitalId])
  @@index([branchId])
  @@index([type])
  @@index([status])
}

model Appointment {
  id         String            @id @default(uuid())
  hospitalId String
  branchId   String?
  patientId  String
  startAt    DateTime
  endAt      DateTime
  status     AppointmentStatus @default(SCHEDULED)
  reason     String?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  hospital  Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch    Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient         Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  resources       AppointmentResource[]
  opdQueueEntries   OpdQueueEntry[]
  clinicalEncounters ClinicalEncounter[]
  surgerySchedule   SurgerySchedule?

  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([startAt])
  @@index([endAt])
  @@index([status])
}

model AppointmentResource {
  appointmentId String
  resourceId    String

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([appointmentId, resourceId])
  @@index([resourceId])
}

model Attendance {
  id                String           @id @default(uuid())
  hospitalId        String
  branchId          String?
  userId            String
  date              DateTime
  clockIn           DateTime?
  clockOut          DateTime?
  status            AttendanceStatus
  lateMinutes       Int              @default(0)
  earlyLeaveMinutes Int              @default(0)
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, userId, date])
  @@index([hospitalId])
  @@index([branchId])
  @@index([userId])
  @@index([date])
  @@index([status])
}

model RosterEntry {
  id             String   @id @default(uuid())
  hospitalId     String
  branchId       String?
  userId         String
  date           DateTime
  shiftStartTime String
  shiftEndTime   String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([hospitalId, userId, date])
  @@index([hospitalId])
  @@index([branchId])
  @@index([userId])
  @@index([date])
}

model AuditLog {
  id         String   @id @default(uuid())
  hospitalId String
  branchId   String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([hospitalId])
  @@index([branchId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Invoice {
  id            String        @id @default(uuid())
  hospitalId    String
  branchId      String?
  patientId     String
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  currency String @default("INR")

  subtotalAmount Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  supplierGstin          String?
  supplierStateCode      String?
  placeOfSupplyStateCode String?
  supplyType             GstSupplyType?

  cgstAmount Decimal @default(0) @db.Decimal(12, 2)
  sgstAmount Decimal @default(0) @db.Decimal(12, 2)
  igstAmount Decimal @default(0) @db.Decimal(12, 2)

  notes    String?
  issuedAt DateTime?
  paidAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  items    InvoiceItem[]
  payments Payment[]
  insuranceClaims InsuranceClaim[]

  @@unique([hospitalId, invoiceNumber])
  @@index([hospitalId])
  @@index([branchId])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id         String @id @default(uuid())
  invoiceId  String
  hospitalId String

  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  hsnSac           String?
  gstRate          Decimal @default(0) @db.Decimal(5, 2)
  taxableAmount    Decimal @db.Decimal(12, 2)
  cgstRate         Decimal @default(0) @db.Decimal(5, 2)
  cgstAmount       Decimal @default(0) @db.Decimal(12, 2)
  sgstRate         Decimal @default(0) @db.Decimal(5, 2)
  sgstAmount       Decimal @default(0) @db.Decimal(12, 2)
  igstRate         Decimal @default(0) @db.Decimal(5, 2)
  igstAmount       Decimal @default(0) @db.Decimal(12, 2)
  lineTotalWithTax Decimal @db.Decimal(12, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([hospitalId])
}

model Payment {
  id         String  @id @default(uuid())
  hospitalId String
  branchId   String?
  invoiceId  String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  provider PaymentProvider @default(RAZORPAY)
  status   PaymentStatus   @default(INITIATED)

  providerPaymentLinkId String?
  providerPaymentId     String?
  providerOrderId       String?

  failureReason String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refunds  Refund[]

  @@unique([provider, providerPaymentLinkId])
  @@unique([provider, providerPaymentId])
  @@index([hospitalId])
  @@index([invoiceId])
  @@index([status])
}

model Refund {
  id         String  @id @default(uuid())
  hospitalId String
  branchId   String?
  paymentId  String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  provider PaymentProvider @default(RAZORPAY)
  status   RefundStatus    @default(REQUESTED)

  providerRefundId  String?
  providerPaymentId String?
  clientRequestId   String?

  reason        String?
  failureReason String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  payment  Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRefundId])
  @@unique([paymentId, clientRequestId])
  @@index([hospitalId])
  @@index([paymentId])
  @@index([status])
}

model PaymentWebhookEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  providerEventId String
  paymentId       String?
  processedAt     DateTime        @default(now())

  @@unique([provider, providerEventId])
}

model WhatsAppConversation {
  id         String  @id @default(uuid())
  hospitalId String
  branchId   String?
  patientId  String

