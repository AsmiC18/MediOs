model Hospital {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  gstin     String?
  stateCode String?
  /** Hospital-wide default consultation fee for staff attendance billing (INR). */
  consultationFeeUnitPrice Decimal? @db.Decimal(12, 2)
  consultationFeeHsnSac    String?
  consultationFeeGstRate   Decimal  @default(0) @db.Decimal(5, 2)
  emergencyVisitFeeUnitPrice Decimal? @db.Decimal(12, 2)
  emergencyVisitFeeHsnSac    String?
  emergencyVisitFeeGstRate   Decimal  @default(0) @db.Decimal(5, 2)
  ipdDischargeFeeUnitPrice Decimal? @db.Decimal(12, 2)
  ipdDischargeFeeHsnSac    String?
  ipdDischargeFeeGstRate   Decimal  @default(0) @db.Decimal(5, 2)
  surgeryProcedureFeeUnitPrice Decimal? @db.Decimal(12, 2)
  surgeryProcedureFeeHsnSac    String?
  surgeryProcedureFeeGstRate   Decimal  @default(0) @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultWorkScheduleId String?                @unique
  defaultWorkSchedule   WorkSchedule?          @relation("HospitalDefaultWorkSchedule", fields: [defaultWorkScheduleId], references: [id], onDelete: SetNull)
  defaultBookingRuleId  String?                @unique
  defaultBookingRule    BookingRule?           @relation("HospitalDefaultBookingRule", fields: [defaultBookingRuleId], references: [id], onDelete: SetNull)
  branches              Branch[]
  users                 User[]
  roles                 Role[]
  patients              Patient[]
  auditLogs             AuditLog[]
  resources             Resource[]
  appointments          Appointment[]
  attendances           Attendance[]
  workSchedules         WorkSchedule[]
  bookingRules          BookingRule[]
  rosterEntries         RosterEntry[]
  leaves                Leave[]
  patientFieldHistories PatientFieldHistory[]
  invoices              Invoice[]
  invoiceItems          InvoiceItem[]
  payments              Payment[]
  refunds               Refund[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages      WhatsAppMessage[]
  whatsAppConfig        WhatsAppConfig?
  abdmHospitalConfig    AbdmHospitalConfig?
  abdmProfessionalLinks AbdmProfessionalLink[]
  patientAbhaLinks      PatientAbhaLink[]
  abdmConsents          AbdmConsent[]
  abdmConsentAuditLogs  AbdmConsentAuditLog[]
  opdQueueEntries       OpdQueueEntry[]
  ipdBeds               IpdBed[]
  ipdAdmissions         IpdAdmission[]
  ipdBedAssignments     IpdBedAssignment[]
  clinicalEncounters    ClinicalEncounter[]
  clinicalSoapNotes     ClinicalSoapNote[]
  clinicalSoapNoteVersions ClinicalSoapNoteVersion[]
  clinicalDiagnoses     ClinicalDiagnosis[]
  prescriptions         Prescription[]
  diagnosticOrders      DiagnosticOrder[]
  diagnosticOrderItems  DiagnosticOrderItem[]
  emergencyVisits       EmergencyVisit[]
  triageRecords         TriageRecord[]
  pharmacyProducts      PharmacyProduct[]
  pharmacyBatches       PharmacyBatch[]
  pharmacyStockMovements PharmacyStockMovement[]
  pharmacyDispensings   PharmacyDispensing[]
  pharmacySuppliers     PharmacySupplier[]
  pharmacyPurchaseOrders PharmacyPurchaseOrder[]
  pharmacyPrescriptionWorkItems PharmacyPrescriptionWorkItem[]
  pharmacyPurchaseOrderReceipts PharmacyPurchaseOrderReceipt[]
  insuranceProviders    InsuranceProvider[]
  insuranceEmpanelments InsuranceEmpanelment[]
  insurancePackages     InsurancePackage[]
  insurancePackageRates InsurancePackageRate[]
  patientInsurancePolicies PatientInsurancePolicy[]
  insurancePreAuthorizations InsurancePreAuthorization[]
  insuranceClaims       InsuranceClaim[]
  surgeryRequests       SurgeryRequest[]
  surgeryPreOpAssessments SurgeryPreOpAssessment[]
  surgerySchedules      SurgerySchedule[]
  surgeryProcedureRecords SurgeryProcedureRecord[]
  surgeryPostOpRecords  SurgeryPostOpRecord[]
  jobs                  Job[]
  domainEventOutbox              DomainEventOutbox[]
  notifications                  Notification[]
  patientNotificationPreferences PatientNotificationPreference[]
  authSessions                   AuthSession[]
  attendanceMonthlySummaries     AttendanceMonthlySummary[]
  clinicalDrugs                  ClinicalDrug[]
  clinicalDrugIngredients        ClinicalDrugIngredient[]
  hospitalFormularyEntries       HospitalFormularyEntry[]
  hospitalClinicalSafetyPolicy   HospitalClinicalSafetyPolicy?
  prescriptionSafetyEvaluations  PrescriptionSafetyEvaluation[]
  prescriptionSafetyFindings     PrescriptionSafetyFinding[]
  clinicalAttachments            ClinicalAttachment[]
  patientPrivacyConsents         PatientPrivacyConsent[]
  patientPrivacyErasureRequests  PatientPrivacyErasureRequest[]
  patientPortalAccounts          PatientPortalAccount[]
  patientPortalSessions          PatientPortalSession[]
  hospitalPlans                  HospitalPlan[]
  patientEngagementActions       PatientEngagementAction[]
  patientNpsResponses            PatientNpsResponse[]
  patientWinbackCampaigns        PatientWinbackCampaign[]
  staffInAppNotifications        StaffInAppNotification[]
  hospitalDepartmentToggles    HospitalDepartmentToggle[]
  billingCatalogueItems          BillingCatalogueItem[]
  paymentCheckoutIntents         PaymentCheckoutIntent[]
  reportProjections            ReportProjection[]
  insurancePreauthAttachments  InsurancePreauthAttachment[]
  ipdDailyChartEntries           IpdDailyChartEntry[]
  surgeryPreOpChecklistItems     SurgeryPreOpChecklistItem[]

  @@index([code])
}

model Plan {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features      PlanFeature[]
  hospitalPlans HospitalPlan[]
}

model PlanFeature {
  id         String   @id @default(uuid())
  planId     String
  featureKey String
  enabled    Boolean  @default(true)
  config     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([planId])
  @@index([featureKey])
}

model HospitalPlan {
  id         String    @id @default(uuid())
  hospitalId String
  planId     String
  isActive   Boolean   @default(true)
  startsAt   DateTime  @default(now())
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([hospitalId])
  @@index([planId])
  @@index([hospitalId, isActive])
  @@index([startsAt])
}

model Branch {
  id         String   @id @default(uuid())
  hospitalId String
  name       String
  code       String
  address    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital              Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  workScheduleId        String?                @unique
  workSchedule          WorkSchedule?          @relation("BranchWorkSchedule", fields: [workScheduleId], references: [id], onDelete: SetNull)
  bookingRuleId         String?                @unique
  bookingRule           BookingRule?           @relation("BranchBookingRule", fields: [bookingRuleId], references: [id], onDelete: SetNull)
  users                 User[]
  patients              Patient[]
  auditLogs             AuditLog[]
  resources             Resource[]
  appointments          Appointment[]
  attendances           Attendance[]
  rosterEntries         RosterEntry[]
  leaves                Leave[]
  attendanceMonthlySummaries AttendanceMonthlySummary[]
  invoices              Invoice[]
  payments              Payment[]
  refunds               Refund[]
  whatsAppConversations WhatsAppConversation[]
  whatsAppMessages      WhatsAppMessage[]
  abdmConsents          AbdmConsent[]
  opdQueueEntries       OpdQueueEntry[]
  ipdBeds               IpdBed[]
  ipdAdmissions         IpdAdmission[]
  clinicalEncounters    ClinicalEncounter[]
  clinicalAttachments   ClinicalAttachment[]
  diagnosticOrders      DiagnosticOrder[]
  emergencyVisits       EmergencyVisit[]
  pharmacyProducts      PharmacyProduct[]
  pharmacyBatches       PharmacyBatch[]
  pharmacyDispensings   PharmacyDispensing[]
  pharmacyPurchaseOrders PharmacyPurchaseOrder[]
  pharmacyPrescriptionWorkItems PharmacyPrescriptionWorkItem[]
  pharmacyPurchaseOrderReceipts PharmacyPurchaseOrderReceipt[]
  insuranceEmpanelments InsuranceEmpanelment[]
  insurancePreAuthorizations InsurancePreAuthorization[]
  insuranceClaims       InsuranceClaim[]
  surgeryRequests       SurgeryRequest[]
  surgerySchedules      SurgerySchedule[]
  jobs                  Job[]
  domainEventOutbox     DomainEventOutbox[]
  notifications         Notification[]
  authSessions          AuthSession[]
  patientPortalSessions PatientPortalSession[]
  patientEngagementActions PatientEngagementAction[]
  patientNpsResponses     PatientNpsResponse[]
  patientWinbackCampaigns PatientWinbackCampaign[]
  staffInAppNotifications StaffInAppNotification[]
  billingCatalogueItems   BillingCatalogueItem[]
  paymentCheckoutIntents  PaymentCheckoutIntent[]
  reportProjections       ReportProjection[]
  insurancePreauthAttachments InsurancePreauthAttachment[]
  ipdDailyChartEntries      IpdDailyChartEntry[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model RateLimitBucket {
  id        String   @id @default(uuid())
  scope     String
  bucketKey String
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, bucketKey])
  @@index([resetAt])
}

model AuthSession {
  id                  String    @id @default(uuid())
  userId              String
  hospitalId          String
  branchId            String?
  refreshTokenHash    String    @unique
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime  @default(now())
  lastUsedAt          DateTime?
  replacedBySessionId String?   @unique
  familyId            String
  revokeReason        String?

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital          Hospital     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch            Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  replacedBySession AuthSession? @relation("AuthSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacesSession   AuthSession? @relation("AuthSessionReplacement")

  @@index([userId, revokedAt])
  @@index([hospitalId, userId])
  @@index([familyId])
}

model WorkSchedule {
  id            String   @id @default(uuid())
  hospitalId    String
  workStartTime String
  workEndTime   String
  timezone      String   @default("Asia/Kolkata")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalDefault Hospital? @relation("HospitalDefaultWorkSchedule")
  branch          Branch?   @relation("BranchWorkSchedule")

  @@index([hospitalId])
}

model BookingRule {
  id                        String   @id @default(uuid())
  hospitalId                String
  minDurationMinutes        Int      @default(5)
  maxDurationMinutes        Int      @default(480)
  slotDurationMinutes       Int      @default(15)
  minimumAdvanceMinutes     Int      @default(0)
  maximumAdvanceMinutes     Int?
  cancellationWindowMinutes Int      @default(0)
  bufferMinutes             Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  hospital        Hospital  @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalDefault Hospital? @relation("HospitalDefaultBookingRule")
  branch          Branch?   @relation("BranchBookingRule")

  @@index([hospitalId])
}

model User {
  id           String     @id @default(uuid())
  hospitalId   String
  branchId     String?
  roleId       String
  name         String
  email        String?
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  hospital              Hospital              @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch                Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role                  Role                  @relation(fields: [roleId], references: [id])
  auditLogs             AuditLog[]
  attendances           Attendance[]
  rosterEntries         RosterEntry[]
  leaves                Leave[]
  attendanceMonthlySummaries AttendanceMonthlySummary[]
  patientFieldHistories PatientFieldHistory[]
  patientsMerged        Patient[]             @relation("PatientMergedBy")
  abdmProfessionalLink  AbdmProfessionalLink?
  abdmConsentsRequested AbdmConsent[]         @relation("ConsentRequestedBy")
  abdmConsentAuditLogs  AbdmConsentAuditLog[]
  clinicalEncountersProvided ClinicalEncounter[] @relation("EncounterProvider")
  clinicalSoapNotesCreated   ClinicalSoapNote[]  @relation("SoapCreatedBy")
  clinicalSoapNoteVersionsCreated ClinicalSoapNoteVersion[] @relation("SoapVersionCreatedBy")
  clinicalDiagnosesCreated   ClinicalDiagnosis[] @relation("DiagnosisCreatedBy")
  prescriptionsPrescribed    Prescription[]      @relation("PrescriptionPrescriber")
  clinicalAttachmentsUploaded ClinicalAttachment[] @relation("ClinicalAttachmentUploadedBy")
  clinicalAttachmentsDeleted  ClinicalAttachment[] @relation("ClinicalAttachmentDeletedBy")
  diagnosticOrdersOrdered    DiagnosticOrder[]   @relation("DiagnosticOrderOrderedBy")
  diagnosticResultsEntered   DiagnosticOrderItem[] @relation("DiagnosticResultEnteredBy")
  diagnosticResultsVerified  DiagnosticOrderItem[] @relation("DiagnosticResultVerifiedBy")
  triageRecordsAssessed      TriageRecord[]        @relation("TriageAssessedBy")
  pharmacyStockMovementsCreated PharmacyStockMovement[] @relation("PharmacyStockMovementCreatedBy")
  pharmacyDispensingsCreated    PharmacyDispensing[]    @relation("PharmacyDispensingCreatedBy")
  pharmacyPurchaseOrdersCreated PharmacyPurchaseOrder[] @relation("PharmacyPurchaseOrderCreatedBy")
  pharmacyPurchaseOrdersApproved PharmacyPurchaseOrder[] @relation("PharmacyPurchaseOrderApprovedBy")
  pharmacyPurchaseOrderReceiptsReceived PharmacyPurchaseOrderReceipt[] @relation("PharmacyPurchaseOrderReceiptReceivedBy")
  pharmacyDispensingSubstitutions PharmacyDispensingItem[] @relation("PharmacySubstitutionBy")
  surgeryRequestsRequested      SurgeryRequest[]        @relation("SurgeryRequestedBy")
  surgeryPreOpAssessments       SurgeryPreOpAssessment[] @relation("SurgeryPreOpAssessedBy")
  surgerySchedulesCreated       SurgerySchedule[]       @relation("SurgeryScheduledBy")
  surgeryProcedureRecordsSurgeon SurgeryProcedureRecord[] @relation("SurgerySurgeon")
  surgeryProcedureRecordsAssistant SurgeryProcedureRecord[] @relation("SurgeryAssistant")
  surgeryPostOpRecords          SurgeryPostOpRecord[]   @relation("SurgeryPostOpRecordedBy")
  authSessions                  AuthSession[]
  doctorResources               Resource[]                @relation("DoctorResourceUser")
  patientPrivacyConsentsRecorded PatientPrivacyConsent[] @relation("PatientPrivacyConsentRecordedBy")
  patientPrivacyErasureRequested PatientPrivacyErasureRequest[] @relation("PatientPrivacyErasureRequestedBy")
  patientPrivacyErasureDecided   PatientPrivacyErasureRequest[] @relation("PatientPrivacyErasureDecidedBy")
  engagementActionsActed         PatientEngagementAction[]      @relation("EngagementActionActedBy")
  engagementActionsDismissed     PatientEngagementAction[]      @relation("EngagementActionDismissedBy")
  winbackCampaignsRequested      PatientWinbackCampaign[]
  staffInAppNotifications        StaffInAppNotification[]
  preauthAttachmentsUploaded     InsurancePreauthAttachment[] @relation("PreauthAttachmentUploadedBy")
  preauthAttachmentsDeleted      InsurancePreauthAttachment[] @relation("PreauthAttachmentDeletedBy")
  ipdDailyChartEntriesRecorded   IpdDailyChartEntry[]         @relation("IpdChartRecordedBy")

  @@unique([hospitalId, email])
  @@index([hospitalId])
  @@index([branchId])
  @@index([roleId])
}

model Role {
  id          String   @id @default(uuid())
  hospitalId  String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital    Hospital         @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([hospitalId, name])
  @@index([hospitalId])
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Patient {
  id                      String               @id @default(uuid())
  hospitalId              String
  branchId                String?
  phone                   String
  firstName               String
  lastName                String?
  email                   String?
  dateOfBirth             DateTime?
  gender                  Gender?
  abhaId                  String?
  allergies               String[]             @default([])
  chronicConditions       String[]             @default([])
  emergencyContacts       Json?
  mergedIntoPatientId     String?
  mergedAt                DateTime?
  mergedByUserId          String?
  isAtRisk                Boolean              @default(false)
  atRiskStatus            PatientAtRiskStatus?
  suggestedAction         String?
  atRiskEvaluatedAt       DateTime?
  daysSinceLastVisit      Int?
  averageVisitCadenceDays Float?
  anonymizedAt            DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  hospital              Hospital               @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  branch                Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  mergedIntoPatient     Patient?               @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id], onDelete: SetNull)
  mergedPatients        Patient[]              @relation("PatientMerge")
  mergedByUser          User?                  @relation("PatientMergedBy", fields: [mergedByUserId], references: [id], onDelete: SetNull)
  appointments          Appointment[]
  fieldHistory          PatientFieldHistory[]
